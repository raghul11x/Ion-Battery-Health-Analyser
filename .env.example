# AI-Assisted Device Parameter Discovery Configuration
OPENROUTER_API_KEY=
HF_API_KEY=

# Default High-Precision & High-Efficiency Models (Free / Serverless Tiers)
# Model 1 (OpenRouter - Meta): 70B parameters, superior Linux kernel & sysfs structure reasoning
OPENROUTER_MODEL_1=meta-llama/llama-3.3-70b-instruct:free

# Model 2 (OpenRouter - Google): Sub-second latency, 1M+ context window, native structured JSON enforcement
OPENROUTER_MODEL_2=google/gemini-2.0-flash-exp:free
# Alternative Model 2 (OpenRouter - Qwen): qwen/qwen-2.5-coder-32b-instruct:free

# Model 3 (Hugging Face Inference API): 7B code specialist, minimal serverless cold-start, highest path accuracy for 7B class
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# Alternative HF Model: meta-llama/Meta-Llama-3.1-8B-Instruct

